{
  "name": "smartcampus-ai",
  "version": "2.0.0",
  "description": "SmartCampus AI - Predict, Optimize & Improve Student Success",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/src/server.js",
    "server": "node --watch server/src/server.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "ml:train": "python -m ml.src.train --all",
    "ml:service": "uvicorn ml.service.main:app --host 0.0.0.0 --port 8000 --reload",
    "ml:cohort": "python -m ml.src.make_demo_cohort",
    "ml:test": "pytest ml/tests"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.0",
    "multer": "^1.4.5-lts.1"
  },
  "keywords": [
    "student-success",
    "machine-learning",
    "analytics",
    "education",
    "fastapi",
    "react",
    "express"
  ],
  "author": "SmartCampus AI Team",
  "license": "MIT"
}
