# Environment Configuration for SmartCampus AI

# Node Server
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/smartcampus_ai
JWT_SECRET=demo_jwt_secret_smartcampus_2026_supersecure

# ML Service Settings
ML_MODE=service            # service | off
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_KEY=smartcampus_secret_internal_ml_key_2026
RISK_FUSION_MODE=escalate_only # escalate_only | rules_only

# Optional LLM / AI Copilot API (Deterministic fallback active when absent)
